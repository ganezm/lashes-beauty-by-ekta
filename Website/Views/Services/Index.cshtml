@model LashesWebsite.Models.PublicBookingStorefront
@using LashesWebsite.Services
@{
    var L = Context.Lang();
    string GroupSlug(string name) => name.Equals("Infill", StringComparison.OrdinalIgnoreCase) ? "infill"
        : name.Contains("brow", StringComparison.OrdinalIgnoreCase) ? "brows" : "lashes";

    var groups = Model.Services
        .GroupBy(s => s.CategoryName ?? "Other")
        .OrderBy(g => GroupSlug(g.Key) switch { "lashes" => 0, "brows" => 1, "infill" => 2, _ => 3 })
        .ToList();
    var coreCount = Model.Services.Count(s => GroupSlug(s.CategoryName ?? "") != "infill");
}
<section class="section" data-reveal>
    <div class="container">
        <div class="eyebrow">@L.T("sv.eyebrow")</div>
        <h1 class="section-title">@L.T("sv.title")</h1>
        <p class="section-copy">@(string.IsNullOrWhiteSpace(L.Pick(Model.Description, Model.DescriptionHi)) ? L.T("sv.lead") : L.Pick(Model.Description, Model.DescriptionHi))</p>

        @if (groups.Count == 0)
        {
            <p class="section-copy">@(L.IsHi ? L.T("sv.updating") : "Services are being updated — check back shortly, or get in touch directly.")</p>
        }
        else
        {
            <div class="trust-bar" style="justify-content:flex-start;border-bottom:0;padding:32px 0 0">
                <div class="trust-stat"><div class="num">@coreCount</div><div class="lbl">@L.T("sv.core")</div></div>
                <div class="trust-stat"><div class="num">@L.H("sv.window")</div><div class="lbl">@L.T("sv.windowLbl")</div></div>
                <div class="trust-stat"><div class="num">@L.T("sv.consult")</div><div class="lbl">@L.T("sv.consultLbl")</div></div>
            </div>

            <div class="pill-row" data-service-filters>
                @foreach (var group in groups)
                {
                    <button class="category-pill" data-filter="@GroupSlug(group.Key)">@group.Key <span class="pill-count">@group.Count()</span></button>
                }
            </div>
            <p class="label-sm" style="margin-top:14px">@L.H("sv.prices")</p>

            @foreach (var group in groups)
            {
                <div data-service-group="@GroupSlug(group.Key)" style="margin-top:48px">
                    <h2 style="font:400 30px/1 'Instrument Serif',serif;margin-bottom:20px">@group.Key</h2>
                    <div class="grid grid-3">
                        @{ var i = 0; }
                        @foreach (var svc in group)
                        {
                            i++;
                            <a class="service-card" href="/book?service=@svc.Id">
                                <div class="row"><span class="idx">@(i.ToString("00"))</span><span class="meta">@svc.DurationMinutes @L.T("svc.min")</span></div>
                                <div class="row"><span class="name">@L.Pick(svc.Name, svc.NameHi)</span><span class="price">&#8377;@svc.Price.ToString("N0")</span></div>
                                @if (!string.IsNullOrWhiteSpace(L.Pick(svc.Description, svc.DescriptionHi)))
                                {
                                    <div class="desc">@L.Pick(svc.Description, svc.DescriptionHi)</div>
                                }
                                @if (svc.PatchTestRequired)
                                {
                                    <div class="svc-patch">@L.T("svc.patch")</div>
                                }
                                <div class="book-look-cta">@L.T("svc.book") &rarr;</div>
                            </a>
                        }
                    </div>
                </div>
            }

            <div class="grid grid-3" style="margin-top:56px">
                <div class="card"><div class="tag">@L.T("sv.patchTag")</div><p>@L.T("sv.patchBody")</p></div>
                <div class="card"><div class="tag">@L.T("sv.infillTag")</div><p>@L.T("sv.infillBody")</p></div>
                <div class="card"><div class="tag">@L.T("sv.addonsTag")</div><p>@L.T("sv.addonsBody")</p></div>
            </div>
        }

        @if (Model.Policy is not null && Model.Policy.DepositRequired)
        {
            <div class="booking-note" style="margin-top:40px;max-width:520px">
                @L.H("sv.policy", ("percent", Model.Policy.DepositPercent), ("hours", Model.Policy.CancellationWindowHours))
            </div>
        }
    </div>
</section>

@section Scripts {
    <script>
        (function () {
            var params = new URLSearchParams(window.location.search);
            var requested = (params.get('category') || '').toLowerCase();
            var pills = document.querySelectorAll('[data-service-filters] .category-pill');
            var groups = document.querySelectorAll('[data-service-group]');
            if (!pills.length) return;

            function apply(filter) {
                pills.forEach(function (p) { p.classList.toggle('active', p.dataset.filter === filter); });
                groups.forEach(function (g) { g.style.display = (filter === 'all' || g.dataset.serviceGroup === filter) ? '' : 'none'; });
            }

            pills.forEach(function (p) { p.addEventListener('click', function () { apply(p.dataset.filter); }); });

            var initial = Array.prototype.some.call(pills, function (p) { return p.dataset.filter === requested; }) ? requested : 'all';
            if (initial === 'all' && pills.length) { pills[0].classList.remove('active'); groups.forEach(function (g) { g.style.display = ''; }); }
            else { apply(initial); }
        })();
    </script>
}
