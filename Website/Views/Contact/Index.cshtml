@model LashesWebsite.Controllers.ContactViewModel
@{
    var loc = Model.Storefront.Locations.FirstOrDefault();
}
<section class="section" data-reveal>
    <div class="container">
        <div class="eyebrow">get in touch</div>
        <h1 class="section-title">The studio</h1>

        <div class="contact-grid" style="margin-top:40px">
            <div class="contact-map">
                @if (!string.IsNullOrWhiteSpace(loc?.MapEmbedUrl))
                {
                    <iframe title="Studio location" src="@loc.MapEmbedUrl"></iframe>
                }
                else
                {
                    <div style="width:100%;height:100%;display:flex;align-items:center;justify-content:center;background:var(--blush-1);color:var(--body-text);font:300 13px/1.6 'Jost',sans-serif">Map coming soon</div>
                }
            </div>
            <div class="contact-info-card">
                @if (!string.IsNullOrWhiteSpace(loc?.Address))
                {
                    <div class="contact-info-row"><div class="k">Address</div><div class="v">@loc.Address</div></div>
                }
                @if (!string.IsNullOrWhiteSpace(loc?.OpeningHoursText))
                {
                    <div class="contact-info-row"><div class="k">Hours</div><div class="v">@loc.OpeningHoursText</div></div>
                }
                @if (!string.IsNullOrWhiteSpace(loc?.Phone) || !string.IsNullOrWhiteSpace(loc?.Email))
                {
                    <div class="contact-info-row"><div class="k">Contact</div><div class="v">@loc?.Phone@(loc?.Phone is not null && loc?.Email is not null ? "\n" : "")@loc?.Email</div></div>
                }
                <div style="display:flex;gap:10px;margin-top:24px">
                    @if (!string.IsNullOrWhiteSpace(loc?.WhatsAppNumber))
                    {
                        <a href="https://wa.me/@loc.WhatsAppNumber" target="_blank" rel="noopener noreferrer" class="btn btn-primary" style="flex:1">WhatsApp</a>
                    }
                    @if (!string.IsNullOrWhiteSpace(loc?.Phone))
                    {
                        <a href="tel:@loc.Phone" class="btn btn-secondary" style="flex:1">Call studio</a>
                    }
                </div>
            </div>
        </div>
    </div>
</section>

<section class="section soft" data-reveal>
    <div class="container grid grid-2">
        <div>
            <h2 class="section-title" style="font-size:36px">Send an enquiry</h2>
            <form id="enquiryForm" style="margin-top:26px">
                <div class="book-field"><label>First name</label><input id="enqFirstName" required /></div>
                <div class="book-field"><label>Last name</label><input id="enqLastName" /></div>
                <div class="book-field"><label>Mobile</label><input id="enqMobile" /></div>
                <div class="book-field"><label>Email</label><input id="enqEmail" type="email" /></div>
                <div class="book-field"><label>Message</label><textarea id="enqMessage" rows="3"></textarea></div>
                <button type="submit" class="btn btn-primary" style="margin-top:20px">Send enquiry &rarr;</button>
                <div id="enquirySent" class="booking-note" style="display:none">Opening your email app to send this to the studio&hellip;</div>
            </form>
        </div>
        <div>
            <h2 class="section-title" style="font-size:36px">FAQ</h2>
            @if (Model.Content.Faqs.Count == 0)
            {
                <p class="section-copy">No FAQs published yet.</p>
            }
            else
            {
                @foreach (var f in Model.Content.Faqs)
                {
                    <div class="faq-item"><div class="faq-q">@f.Question</div><div class="faq-a">@f.Answer</div></div>
                }
            }
        </div>
    </div>
</section>

@section Scripts {
    <script>
        (function () {
            var form = document.getElementById('enquiryForm');
            if (!form) return;
            form.addEventListener('submit', function (e) {
                e.preventDefault();
                var first = document.getElementById('enqFirstName').value.trim();
                var last = document.getElementById('enqLastName').value.trim();
                var mobile = document.getElementById('enqMobile').value.trim();
                var email = document.getElementById('enqEmail').value.trim();
                var message = document.getElementById('enqMessage').value.trim();
                var studioEmail = @Html.Raw(LashesWebsite.Services.JsonHelper.ToCamelJson(loc?.Email ?? ""));
                if (!studioEmail) { return; }
                var subject = 'Enquiry from ' + first + (last ? ' ' + last : '');
                var body = 'Name: ' + first + ' ' + last + '\nMobile: ' + (mobile || '-') + '\nEmail: ' + (email || '-') + '\n\n' + message;
                window.location.href = 'mailto:' + studioEmail + '?subject=' + encodeURIComponent(subject) + '&body=' + encodeURIComponent(body);
                document.getElementById('enquirySent').style.display = 'block';
            });
        })();
    </script>
}
