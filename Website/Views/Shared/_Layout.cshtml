@using LashesWebsite.Models
@using LashesWebsite.Services
@{
    var L = Context.Lang();
    var content = ViewData["Content"] as PublicWebsiteContent;
    var path = Context.Request.Path.Value ?? "/";
    bool IsActive(string href) => href == "/" ? path == "/" : path.StartsWith(href, StringComparison.OrdinalIgnoreCase);
    var brandColor = content?.PrimaryColor ?? "#be11a0";
}
<!DOCTYPE html>
<html lang="@L.Code">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="@brandColor" />
    <title>@(ViewData["Title"] as string ?? content?.BusinessName ?? "Lashes & Beauty")</title>
    @if (!string.IsNullOrWhiteSpace(content?.MetaDescription))
    {
        <meta name="description" content="@content.MetaDescription" />
    }
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&amp;family=Jost:wght@200;300;400;500;600&amp;family=Noto+Sans+Devanagari:wght@300;400;500;600&amp;family=Noto+Serif+Devanagari:wght@400;500&amp;display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>:root{--magenta:@brandColor;}</style>
</head>
<body class="ek-root">

@if (content?.MarqueeMessages.Count > 0)
{
    <div class="marquee">
        <div class="marquee-track">
            @for (var i = 0; i < 2; i++)
            {
                foreach (var m in content.MarqueeMessages)
                {
                    <span class="marquee-item">@m.Text <span class="dot">&#9670;</span></span>
                }
            }
        </div>
    </div>
}

<header class="nav-bar">
    <a class="nav-brand" href="/">
        @if (!string.IsNullOrWhiteSpace(content?.LogoUrl))
        {
            <img src="@content.LogoUrl" alt="@content.BusinessName" />
        }
        else
        {
            @(content?.BusinessName ?? "Studio")
        }
    </a>
    <nav class="nav-links">
        <a href="/" class="@(IsActive("/") ? "active" : "")">@L.T("nav.home")</a>
        <a href="/services" class="@(IsActive("/services") ? "active" : "")">@L.T("nav.services")</a>
        <a href="/lookbook" class="@(IsActive("/lookbook") ? "active" : "")">@L.T("nav.lookbook")</a>
        <a href="/academy" class="@(IsActive("/academy") ? "active" : "")">@L.T("nav.academy")</a>
        <a href="/about" class="@(IsActive("/about") ? "active" : "")">@L.T("nav.about")</a>
        <a href="/contact" class="@(IsActive("/contact") ? "active" : "")">@L.T("nav.studio")</a>
    </nav>
    <div style="display:flex;align-items:center;gap:14px">
        <div class="lang-switch" role="group" aria-label="@L.T("nav.language")">
            <a href="@SiteLang.SwitchUrl(Context.Request, "en")" class="@(L.IsHi ? "" : "active")" hreflang="en" lang="en">English</a>
            <a href="@SiteLang.SwitchUrl(Context.Request, "hi")" class="@(L.IsHi ? "active" : "")" hreflang="hi" lang="hi">हिन्दी</a>
        </div>
        <a href="/book" class="btn btn-primary nav-cta">@L.T("nav.book")</a>
        <button class="mobile-menu-btn" id="mobileMenuBtn" aria-label="@L.T("nav.menu")">&#9776;</button>
    </div>
</header>

<div class="mobile-menu" id="mobileMenu">
    <button class="mobile-menu-btn" id="mobileMenuClose" aria-label="@L.T("nav.close")" style="align-self:flex-end;display:block;font-size:26px">&times;</button>
    <a href="/">@L.T("nav.home")</a>
    <a href="/services">@L.T("nav.services")</a>
    <a href="/lookbook">@L.T("nav.lookbook")</a>
    <a href="/academy">@L.T("nav.academy")</a>
    <a href="/about">@L.T("nav.about")</a>
    <a href="/contact">@L.T("nav.studio")</a>
    <a href="/book">@L.T("nav.book")</a>
    <div class="lang-switch lang-switch-menu">
        <a href="@SiteLang.SwitchUrl(Context.Request, "en")" class="@(L.IsHi ? "" : "active")" hreflang="en" lang="en">English</a>
        <a href="@SiteLang.SwitchUrl(Context.Request, "hi")" class="@(L.IsHi ? "active" : "")" hreflang="hi" lang="hi">हिन्दी</a>
    </div>
</div>

<main>
    @RenderBody()
</main>

<footer class="site-footer">
    <div class="container footer-grid">
        <div>
            <div class="nav-brand" style="color:#fff">
                @if (!string.IsNullOrWhiteSpace(content?.LogoUrl))
                {
                    <img src="@content.LogoUrl" alt="@content.BusinessName" style="filter:brightness(0) invert(1)" />
                }
                else
                {
                    @(content?.BusinessName ?? "Studio")
                }
            </div>
            <p class="footer-tagline">@(content?.FooterTagline ?? L.T("footer.tagline"))</p>
        </div>
        @if (content is not null)
        {
            foreach (var column in content.FooterLinks.Select(l => l.Column).Distinct())
            {
                <div class="footer-col">
                    <h4>@column</h4>
                    @foreach (var link in content.FooterLinks.Where(l => l.Column == column))
                    {
                        if (string.IsNullOrWhiteSpace(link.Url)) { <span>@link.Text</span> }
                        else { <a href="@link.Url">@link.Text</a> }
                    }
                </div>
            }
        }
    </div>
    <div class="container footer-bottom">
        <span>@(content?.CopyrightText ?? $"© {DateTime.UtcNow.Year} {content?.BusinessName}")</span>
        <span>
            <span class="lang-switch lang-switch-footer" style="margin-right:16px">
                <a href="@SiteLang.SwitchUrl(Context.Request, "en")" class="@(L.IsHi ? "" : "active")" hreflang="en" lang="en">English</a>
                <a href="@SiteLang.SwitchUrl(Context.Request, "hi")" class="@(L.IsHi ? "active" : "")" hreflang="hi" lang="hi">हिन्दी</a>
            </span>
            @if (!string.IsNullOrWhiteSpace(content?.SocialInstagramUrl)) { <a href="@content.SocialInstagramUrl" style="margin-right:16px">@L.T("footer.instagram")</a> }
            @if (!string.IsNullOrWhiteSpace(content?.SocialFacebookUrl)) { <a href="@content.SocialFacebookUrl">@L.T("footer.facebook")</a> }
        </span>
    </div>
</footer>

@{
    var location = (ViewData["Storefront"] as PublicBookingStorefront)?.Locations.FirstOrDefault();
}
<div class="fab-stack">
    @if (!string.IsNullOrWhiteSpace(location?.WhatsAppNumber))
    {
        <a class="fab fab-whatsapp" href="https://wa.me/@location.WhatsAppNumber" target="_blank" rel="noopener noreferrer" aria-label="WhatsApp">WA</a>
    }
    @if (!string.IsNullOrWhiteSpace(location?.Phone))
    {
        <a class="fab fab-call" href="tel:@location.Phone" aria-label="@L.T("common.callStudio")">@L.T("common.call")</a>
    }
</div>

<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
