@model LashesWebsite.Models.PublicWebsiteContent
@using LashesWebsite.Services
@{
    var L = Context.Lang();
}
<section class="section dark" data-reveal>
    <div class="container">
        <div class="eyebrow" style="color:var(--accent-pink-2)">@L.T("ac.eyebrow")</div>
        <h1 class="section-title" style="color:#fff">@L.H("ac.title", ("name", Model.BusinessName))</h1>
        <p class="section-copy" style="color:rgba(255,255,255,.8)">@L.T("ac.lead")</p>
    </div>
</section>

@if (Model.AcademyCourses.Count == 0)
{
    <section class="section"><div class="container"><p class="section-copy">@(L.IsHi ? L.T("ac.soon") : "Course dates are being finalized — check back soon.")</p></div></section>
}
else
{
    <section class="section" data-reveal>
        <div class="container">
            <div class="grid grid-3">
                @foreach (var course in Model.AcademyCourses)
                {
                    <div class="card">
                        <div class="tag">@course.Level</div>
                        <h3>@course.Name</h3>
                        @if (!string.IsNullOrWhiteSpace(course.Meta))
                        {
                            <div class="label-sm" style="margin-top:10px">@course.Meta</div>
                        }
                        <div style="margin:16px 0;height:1px;background:var(--border-hairline)"></div>
                        @foreach (var m in course.Modules)
                        {
                            <div style="display:flex;gap:10px;padding:5px 0;font:300 13px/1.5 'Jost',sans-serif;color:var(--body-text)">
                                <span style="color:var(--magenta)">&#9670;</span>@m
                            </div>
                        }
                        <div style="margin-top:20px;font:400 32px/1 'Instrument Serif',serif;color:var(--magenta)">&#8377;@course.Price.ToString("N0")</div>
                        <a href="/contact" class="btn btn-secondary btn-block" style="margin-top:16px">@L.T("ac.reserve")</a>
                    </div>
                }
            </div>

            @{
                var allIntakes = Model.AcademyCourses.SelectMany(c => c.Intakes.Select(i => new { Course = c.Name, Intake = i })).OrderBy(x => x.Intake.StartDate).ToList();
            }
            @if (allIntakes.Count > 0)
            {
                <div class="intake-table">
                    <div class="intake-row head">
                        <span>@L.T("ac.upcoming")</span><span>@L.T("ac.course")</span><span>@L.T("ac.seatsLeft")</span><span></span>
                    </div>
                    @foreach (var row in allIntakes)
                    {
                        <div class="intake-row">
                            <span style="font:400 18px/1 'Instrument Serif',serif;color:var(--ink-2)">@L.Date(row.Intake.StartDate, false) &ndash; @L.Date(row.Intake.EndDate, true)</span>
                            <span>@row.Course</span>
                            <span style="color:var(--magenta)">@L.T("ac.seatsOf").Replace("{left}", (row.Intake.SeatsTotal - row.Intake.SeatsBooked).ToString()).Replace("{total}", row.Intake.SeatsTotal.ToString())</span>
                            <span><a href="/contact" class="btn btn-secondary" style="padding:10px 16px">@L.T("ac.enquire")</a></span>
                        </div>
                    }
                </div>
            }
        </div>
    </section>
}
