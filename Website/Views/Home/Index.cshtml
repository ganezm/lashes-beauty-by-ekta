@model LashesWebsite.Controllers.HomeViewModel
@{
    var c = Model.Content;
    var s = Model.Storefront;
    var featured = s.Services.Where(x => x.Featured).ToList();
    if (featured.Count == 0) featured = s.Services.Take(5).ToList();
}

@if (c.HeroSlides.Count > 0)
{
    <section class="hero">
        <div class="hero-media">
            @for (var i = 0; i < c.HeroSlides.Count; i++)
            {
                var slide = c.HeroSlides[i];
                if (!string.IsNullOrWhiteSpace(slide.VideoUrl))
                {
                    <video data-hero-media="@i" class="@(i == 0 ? "active" : "")" muted playsinline loop poster="@slide.PosterImageUrl" src="@slide.VideoUrl"></video>
                }
                else if (!string.IsNullOrWhiteSpace(slide.PosterImageUrl))
                {
                    <img data-hero-media="@i" class="@(i == 0 ? "active" : "")" src="@slide.PosterImageUrl" alt="" />
                }
            }
        </div>
        <div class="hero-scrim"></div>
        <div class="hero-content" data-hero-text>
            <div class="hero-kicker">@c.HeroSlides[0].Kicker</div>
            <h1 class="hero-title">@c.HeroSlides[0].HeadlineLine1 <em>@c.HeroSlides[0].HeadlineLine2</em></h1>
            <p class="hero-body">@c.HeroSlides[0].Body</p>
            <div class="hero-actions">
                <a href="/book" class="btn btn-primary">Book appointment &rarr;</a>
                <a href="/services" class="btn btn-secondary">Explore services</a>
            </div>
        </div>
        @if (c.HeroSlides.Count > 1)
        {
            <div class="hero-tabs" data-hero-tabs>
                @for (var i = 0; i < c.HeroSlides.Count; i++)
                {
                    <button class="hero-tab @(i == 0 ? "active" : "")" data-hero-tab="@i">
                        <span class="hero-tab-num">@((i + 1).ToString("00"))</span>
                        <span class="hero-tab-label">@(string.IsNullOrWhiteSpace(c.HeroSlides[i].TabLabel) ? c.HeroSlides[i].Kicker : c.HeroSlides[i].TabLabel)</span>
                        <span class="hero-tab-bar"><span class="hero-tab-fill"></span></span>
                    </button>
                }
            </div>
        }
        <div class="hero-play-control" data-hero-play>
            <span data-hero-play-label>Playing</span>
            <button type="button" aria-label="Pause hero video">&#10074;&#10074;</button>
        </div>
    </section>
}
else
{
    <section class="section dark">
        <div class="container">
            <h1 class="section-title" style="color:#fff">@c.BusinessName</h1>
            <p class="section-copy" style="color:rgba(255,255,255,.75)">@c.CtaBody</p>
            <a href="/book" class="btn btn-primary" style="margin-top:20px">Book appointment &rarr;</a>
        </div>
    </section>
}

@if (c.TrustStats.Count > 0)
{
    <div class="trust-bar">
        @foreach (var t in c.TrustStats)
        {
            <div class="trust-stat"><div class="num">@t.Number</div><div class="lbl">@t.Label</div></div>
        }
    </div>
}

@if (!string.IsNullOrWhiteSpace(c.PhilosophyHeadlineLine1))
{
    <section class="split-section @(string.IsNullOrWhiteSpace(c.PhilosophyImageUrl) ? "no-image" : "")" data-reveal>
            <div class="split-text">
                <div class="eyebrow">our philosophy</div>
                <h2 class="section-title">@c.PhilosophyHeadlineLine1 @if (!string.IsNullOrWhiteSpace(c.PhilosophyHeadlineEmphasis)) { <em>@c.PhilosophyHeadlineEmphasis</em> }</h2>
                @if (!string.IsNullOrWhiteSpace(c.PhilosophyBody))
                {
                    <p class="section-copy">@c.PhilosophyBody</p>
                }
                <a href="/about" class="btn btn-secondary" style="margin-top:26px">Discover our story &rarr;</a>
            </div>
            @if (!string.IsNullOrWhiteSpace(c.PhilosophyImageUrl))
            {
                <div class="split-photo"><div class="split-photo-crop"><img src="@c.PhilosophyImageUrl" alt="" loading="lazy" /></div></div>
            }
    </section>
}

@if (featured.Count > 0)
{
    <section class="section soft" data-reveal>
        <div class="container">
            <div class="eyebrow">the lash edit</div>
            <h2 class="section-title">Find the look that feels unmistakably you</h2>
            <div class="grid grid-3" style="margin-top:40px">
                @{ var fi = 0; }
                @foreach (var svc in featured)
                {
                    fi++;
                    <a class="service-card @(string.IsNullOrWhiteSpace(svc.ImageUrl) ? "" : "has-photo")" href="/book?service=@svc.Id">
                        @if (!string.IsNullOrWhiteSpace(svc.ImageUrl))
                        {
                            <div class="service-card-photo"><img src="@svc.ImageUrl" alt="" loading="lazy" /><span class="idx">@(fi.ToString("00"))</span></div>
                        }
                        <div class="service-card-body">
                            <div class="name">@svc.Name</div>
                            @if (!string.IsNullOrWhiteSpace(svc.Description))
                            {
                                <div class="desc">@svc.Description</div>
                            }
                            <div class="row" style="margin-top:14px"><span class="price">&#8377;@svc.Price.ToString("N0")</span><span class="meta">@svc.DurationMinutes min</span></div>
                            <div class="book-look-cta">Book this look &rarr;</div>
                        </div>
                    </a>
                }
            </div>
        </div>
    </section>
}

@if (c.QuizResults.Count > 0)
{
    <section class="split-section @(string.IsNullOrWhiteSpace(c.QuizImageUrl) ? "no-image" : "")" data-reveal id="find-your-look">
            <div class="split-text">
                <div class="eyebrow">find your look</div>
                <h2 class="section-title">What&rsquo;s your <em>lash personality?</em></h2>
                <div class="grid grid-4" style="margin-top:40px" data-quiz>
                    @for (var i = 0; i < c.QuizResults.Count; i++)
                    {
                        var q = c.QuizResults[i];
                        <button class="card quiz-option @(i == 0 ? "active" : "")" style="text-align:left;border:0;cursor:pointer" data-quiz-btn="@i">
                            <span class="quiz-swatch"></span>
                            <div class="tag">@q.Name</div>
                            <p style="margin-top:8px">@q.Descriptor</p>
                        </button>
                    }
                </div>
                <div class="card" style="margin-top:20px;padding:26px" data-quiz-result>
                    <div class="label-sm" data-quiz-name>Your match &middot; @c.QuizResults[0].Name</div>
                    <p style="margin:10px 0 0;font:300 14px/1.7 'Jost',sans-serif;color:var(--body-text)" data-quiz-copy>@c.QuizResults[0].ResultCopy</p>
                    <a href="/book?service=@c.QuizResults[0].RecommendedServiceId" class="btn btn-primary" style="margin-top:16px" data-quiz-cta>
                        Book @c.QuizResults[0].RecommendedServiceName &rarr;
                    </a>
                </div>
                <script type="application/json" id="quiz-data">@Html.Raw(LashesWebsite.Services.JsonHelper.ToCamelJson(c.QuizResults.Select(q => new { q.Name, q.ResultCopy, q.RecommendedServiceId, q.RecommendedServiceName })))</script>
            </div>
            @if (!string.IsNullOrWhiteSpace(c.QuizImageUrl))
            {
                <div class="split-photo"><div class="split-photo-crop"><img src="@c.QuizImageUrl" alt="" loading="lazy" /></div></div>
            }
    </section>
}

@if (c.BeforeAfterPairs.Count > 0)
{
    <section class="section soft" data-reveal>
        <div class="container">
            <div class="eyebrow">real results</div>
            <h2 class="section-title">Before &amp; after</h2>
            <div class="before-after" style="margin-top:40px">
                @foreach (var pair in c.BeforeAfterPairs.Take(2))
                {
                    <div class="before-after-card"><img src="@pair.BeforeImageUrl" alt="Before" /><span class="before-after-label">Before</span></div>
                    <div class="before-after-card"><img src="@pair.AfterImageUrl" alt="After" /><span class="before-after-label">After</span></div>
                }
            </div>
        </div>
    </section>
}

@if (c.MembershipPlans.Count > 0)
{
    <section class="section" data-reveal id="memberships">
        <div class="container">
            <div class="eyebrow">memberships</div>
            <h2 class="section-title">Keep the look on retainer</h2>
            <div class="grid grid-3" style="margin-top:40px">
                @foreach (var plan in c.MembershipPlans)
                {
                    <div class="card plan-card @(!string.IsNullOrWhiteSpace(plan.BadgeLabel) && plan.BadgeLabel.Equals("Most chosen", StringComparison.OrdinalIgnoreCase) ? "featured" : "")">
                        @if (!string.IsNullOrWhiteSpace(plan.BadgeLabel))
                        {
                            <span class="plan-badge">@plan.BadgeLabel</span>
                        }
                        <div class="plan-name">@plan.Name</div>
                        <div class="plan-price">
                            <span class="amt">&#8377;@plan.MonthlyPrice.ToString("N0")</span>
                            <span class="per">/ month</span>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(plan.PerksText))
                        {
                            <ul class="plan-perks">
                                @foreach (var perk in plan.PerksText.Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
                                {
                                    <li>@perk</li>
                                }
                            </ul>
                        }
                        <a href="/contact" class="btn btn-secondary btn-block" style="margin-top:22px">Choose plan</a>
                    </div>
                }
            </div>
        </div>
    </section>
}

@if (c.GalleryItems.Count > 0)
{
    var homeGallery = c.GalleryItems.Where(g => g.FeaturedOnHome).Take(8).ToList();
    if (homeGallery.Count == 0) homeGallery = c.GalleryItems.Take(8).ToList();
    <section class="section soft" data-reveal>
        <div class="container">
            <div class="eyebrow">work from the chair</div>
            <h2 class="section-title">Lookbook</h2>
            <div class="gallery-grid">
                @foreach (var g in homeGallery)
                {
                    <div class="gallery-tile @g.LayoutHint" onclick="location.href='/lookbook'">
                        <img src="@g.ImageUrl" alt="@g.Category" loading="lazy" />
                        <span class="tag">@g.Category</span>
                    </div>
                }
            </div>
            <div style="text-align:center;margin-top:30px"><a href="/lookbook" class="btn btn-secondary">View full lookbook</a></div>
        </div>
    </section>
}

@if (c.Team.Count > 0)
{
    <section class="section" data-reveal>
        <div class="container">
            <div class="eyebrow">the studio</div>
            <h2 class="section-title">Meet the artists</h2>
            <div class="grid grid-3" style="margin-top:40px">
                @foreach (var t in c.Team)
                {
                    <div class="team-card">
                        @if (!string.IsNullOrWhiteSpace(t.PhotoUrl))
                        {
                            <img class="team-photo" src="@t.PhotoUrl" alt="@t.Name" />
                        }
                        <div class="team-name">@t.Name</div>
                        <div class="team-role">@t.Designation</div>
                        @if (!string.IsNullOrWhiteSpace(t.Bio))
                        {
                            <p class="team-bio">@t.Bio</p>
                        }
                    </div>
                }
            </div>
        </div>
    </section>
}

@if (c.Testimonials.Count > 0)
{
    <section class="section soft" data-reveal data-testimonials>
        <div class="container" style="text-align:center">
            <div class="eyebrow">reviews</div>
            <div class="testimonial-quote" style="margin:24px auto 0" data-testimonial-quote>&ldquo;@c.Testimonials[0].QuoteText&rdquo;</div>
            <div class="testimonial-attr" data-testimonial-attr>@c.Testimonials[0].AttributionFreeText</div>
            @if (c.Testimonials.Count > 1)
            {
                <div style="display:flex;gap:14px;justify-content:center;margin-top:24px">
                    <button class="btn btn-secondary" data-testimonial-prev>&larr;</button>
                    <button class="btn btn-secondary" data-testimonial-next>&rarr;</button>
                </div>
                <script type="application/json" id="testimonials-data">@Html.Raw(LashesWebsite.Services.JsonHelper.ToCamelJson(c.Testimonials.Select(t => new { t.QuoteText, t.AttributionFreeText })))</script>
            }
        </div>
    </section>
}

@if (!string.IsNullOrWhiteSpace(c.SocialInstagramUrl))
{
    <section class="section soft" data-reveal>
        <div class="container" style="text-align:center">
            <div class="eyebrow">@@lashesandbeauty.ekta</div>
            <a href="@c.SocialInstagramUrl" target="_blank" rel="noopener noreferrer" class="btn btn-secondary" style="margin-top:14px">Follow the feed &rarr;</a>
            <div class="grid grid-2" style="max-width:460px;margin:32px auto 0">
                <div class="reel-tile"><video src="/images/reels/reel-1.mp4" muted loop playsinline autoplay></video></div>
                <div class="reel-tile"><video src="/images/reels/reel-2.mp4" muted loop playsinline autoplay></video></div>
            </div>
        </div>
    </section>
}

<section class="section" data-reveal>
    <div class="container">
        <div class="eyebrow">aftercare journal</div>
        <h2 class="section-title">How to keep them perfect</h2>
        <div class="grid grid-3" style="margin-top:40px">
            <div class="card">
                <div class="tag">aftercare</div>
                <h3>The first 24 hours after your set</h3>
                <p>No steam, no oil cleanser, no sleeping face-down. What actually damages retention.</p>
                <div class="label-sm" style="margin-top:14px">4 min read</div>
            </div>
            <div class="card">
                <div class="tag">retention</div>
                <h3>Why lashes shed faster in monsoon</h3>
                <p>Humidity changes cure time and shedding cycles. How to adjust your infill schedule.</p>
                <div class="label-sm" style="margin-top:14px">5 min read</div>
            </div>
            <div class="card">
                <div class="tag">choosing</div>
                <h3>Classic vs hybrid vs volume</h3>
                <p>A plain comparison of weight, look and upkeep, so you book the right set once.</p>
                <div class="label-sm" style="margin-top:14px">6 min read</div>
            </div>
        </div>
    </div>
</section>

<section class="section" data-reveal id="gift-cards">
    <div class="container">
        <div class="giftcards-layout" style="display:grid;grid-template-columns:1.2fr 1fr;gap:40px;align-items:center">
            <div>
                <div class="eyebrow">gift cards</div>
                <h2 class="section-title">Give the set, not the guesswork.</h2>
                <p class="section-copy">Digital gift cards delivered instantly, redeemable against any service or infill.</p>
                <div class="giftcard-denoms">
                    @foreach (var amount in new[] { 2000, 3800, 5000, 7100 })
                    {
                        <span class="giftcard-denom">&#8377;@amount.ToString("N0")</span>
                    }
                </div>
                <a href="/gift-cards" class="btn btn-primary" style="margin-top:26px">Buy a gift card &rarr;</a>
            </div>
            <div class="giftcard-photo" style="@(string.IsNullOrWhiteSpace(c.GiftCardImageUrl) ? "background:var(--blush-1)" : $"background-image:url('{c.GiftCardImageUrl}')")">
                <div class="giftcard-visual">
                    <div class="brand">
                        @if (!string.IsNullOrWhiteSpace(c.LogoUrl))
                        {
                            <img src="@c.LogoUrl" alt="" />
                        }
                        @c.BusinessName
                    </div>
                    <div class="amt">&#8377;5,000</div>
                    <div class="footer-row"><span>Gift card</span><span>No expiry</span></div>
                </div>
            </div>
        </div>
    </div>
</section>

@if (!string.IsNullOrWhiteSpace(c.CtaHeadline))
{
    <section class="final-cta" style="@(string.IsNullOrWhiteSpace(c.FinalCtaImageUrl) ? "" : $"background-image:linear-gradient(160deg,rgba(190,17,160,.88),rgba(168,12,140,.88)),url('{c.FinalCtaImageUrl}');background-size:cover;background-position:center")">
        <div class="container">
            <h2>@c.CtaHeadline</h2>
            <p>@c.CtaBody</p>
            <a href="/book" class="btn btn-primary">@(c.CtaButtonLabel ?? "Book now")</a>
        </div>
    </section>
}
